package main

import "fmt"

// Interactive Demo deck, served from inside the app. Each slide is one viewport tall and
// the page scroll-snaps; datastar's window keydown maps → ← Enter Home End and f (fullscreen).
// ↓ / ↑ / PgDn / PgUp / Space work natively. Ctrl+P → Save as PDF for the Canvas upload.
//
// Pressing → on slide `liveSlide` leaves the deck for /demo. From there → / Enter returns to
// the slide after it, ← / Esc returns to it (see DemoContent in demo.templ).
//
// Wire-up:  r.Get("/presentation", templ.Handler(Presentation()).ServeHTTP)
//
// To add a slide: write a templ SlideN, add it to the list in Presentation, bump totalSlides,
// and fix the ranges in sectionOf (and liveSlide if it moved).

var presenters = []string{"David Kendall", "Ryan Phillips", "Sawyer Evans", "Graham Taggart"}

// One goal per presenter for the "By end of semester" column on slide 8.
// VERIFY: these are the unfinished core-scope items from the proposal, assigned arbitrarily.
// Reassign to match who actually owns what.
var semesterGoals = map[string]string{
	"David Kendall":  "Excel / CSV import into the ledger",
	"Ryan Phillips":  "Owner, editor and viewer roles",
	"Sawyer Evans":   "Balance sheet, P&L and cash flow views",
	"Graham Taggart": "Diff any two versions of the books; REST export",
}

const totalSlides = 9

// the slide where → opens the live app instead of advancing
const liveSlide = 5

// current slide = viewports scrolled + 1. Guarded `if` chain rather than `&&` tricks so
// the live-slide case can't also fall through to a scroll.
func deckKeys() string {
	return fmt.Sprintf(`
		const cur = Math.round(scrollY / innerHeight) + 1;
		if ((evt.key === 'ArrowRight' || evt.key === 'Enter') && cur === %d) { location.href = '/demo'; }
		else if (evt.key === 'ArrowRight' || evt.key === 'Enter') { scrollBy({top: innerHeight, behavior: 'smooth'}); }
		else if (evt.key === 'ArrowLeft') { scrollBy({top: -innerHeight, behavior: 'smooth'}); }
		else if (evt.key === 'Home') { scrollTo({top: 0, behavior: 'smooth'}); }
		else if (evt.key === 'End') { scrollTo({top: document.body.scrollHeight, behavior: 'smooth'}); }
		else if (evt.key === 'f') { document.documentElement.requestFullscreen(); }
	`, liveSlide)
}

templ Presentation() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Summa - Presentation</title>
			<link rel="icon" type="image/png" href="/assets/images/summa-mark-primary.png"/>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"></script>
			@DeckStyle()
		</head>
		<body data-on:keydown__window={ deckKeys() }>
			@Slide1()
			@Slide2()
			@Slide3()
			@Slide4()
			@Slide5()
			@Slide6()
			@Slide7()
			@Slide8()
			@Slide9()
		</body>
	</html>
}

templ DeckStyle() {
	<style>
		:root {
			color: #132c52;
			background: #f7f5ef;
			font-family:
				Inter,
				ui-sans-serif,
				system-ui,
				-apple-system,
				"Segoe UI",
				sans-serif;
			--footer-h: 58px;
		}
		* {
			box-sizing: border-box;
		}
		html {
			scroll-snap-type: y mandatory;
			scroll-behavior: smooth;
		}
		body {
			margin: 0;
		}
		h1,
		h2,
		h3,
		p,
		ul,
		ol {
			margin-top: 0;
		}

		/* ---------- slide ---------- */
		.slide {
			display: flex;
			flex-direction: column;
			height: 100vh;
			scroll-snap-align: start;
			scroll-snap-stop: always;
		}
		.slide-inner {
			display: flex;
			flex: 1;
			flex-direction: column;
			margin: 0 auto;
			max-width: 1500px;
			min-height: 0;
			padding: clamp(28px, 4vw, 64px) clamp(32px, 6vw, 110px);
			width: 100%;
		}

		/* ---------- type (projector-sized) ---------- */
		.eyebrow {
			color: #008265;
			font-size: clamp(0.95rem, 1.3vw, 1.2rem);
			font-weight: 760;
			letter-spacing: 0.075em;
			margin: 0 0 12px;
			text-transform: uppercase;
		}
		h1 {
			color: #102e53;
			font-size: clamp(3.2rem, 7vw, 6rem);
			letter-spacing: -0.045em;
			line-height: 1.02;
			margin-bottom: 18px;
		}
		h2 {
			color: #102e53;
			font-size: clamp(2.1rem, 4.2vw, 3.6rem);
			letter-spacing: -0.04em;
			line-height: 1.08;
			margin-bottom: clamp(20px, 3vh, 36px);
		}
		h3 {
			color: #102e53;
			font-size: clamp(1.3rem, 2vw, 1.8rem);
			letter-spacing: -0.02em;
			margin-bottom: 12px;
		}
		.lede {
			color: #607390;
			font-size: clamp(1.4rem, 2.4vw, 2.1rem);
			margin-bottom: 0;
		}
		.slide ul,
		.slide ol {
			color: #294362;
			font-size: clamp(1.3rem, 2.2vw, 2rem);
			line-height: 1.4;
			padding-left: 1.1em;
		}
		.slide li {
			margin-bottom: 0.45em;
		}
		.slide li strong {
			color: #102e53;
		}
		.slide li::marker {
			color: #008864;
		}
		.note {
			color: #607390;
			font-size: clamp(1rem, 1.5vw, 1.3rem);
			margin: auto 0 0;
		}

		.slide-title .slide-inner {
			align-items: center;
			justify-content: center;
			text-align: center;
		}
		.title-mark {
			height: clamp(72px, 10vw, 120px);
			margin-bottom: 24px;
			width: auto;
		}
		.presenters {
			color: #607390;
			font-size: clamp(1.1rem, 1.6vw, 1.4rem);
			margin-top: 36px;
		}
		.presenters span {
			color: #8fa8bf;
		}

		.two-up {
			align-items: start;
			display: grid;
			flex: 1;
			gap: clamp(24px, 4vw, 64px);
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
			min-height: 0;
		}

		/* screenshots / diagrams — same card treatment as the dashboard */
		.shot {
			background: #fff;
			border: 1px solid #e6e8e4;
			border-radius: 12px;
			box-shadow: 0 3px 12px #173a5810;
			margin: 0;
			overflow: hidden;
		}
		.shot img {
			display: block;
			height: auto;
			width: 100%;
		}
		.shot figcaption {
			color: #607390;
			font-size: 1rem;
			padding: 10px 16px;
		}

		/* ---------- footer (rendered per slide) ---------- */
		.deck-footer {
			align-items: center;
			background: linear-gradient(90deg, #0f3556, #0a2945);
			color: #f8fbff;
			display: grid;
			flex: 0 0 var(--footer-h);
			grid-template-columns: 1fr auto 1fr;
			padding: 0 clamp(18px, 3vw, 40px);
		}
		.deck-team {
			align-items: center;
			color: #dce7f3;
			display: flex;
			font-size: 0.9rem;
			gap: 12px;
		}
		.deck-team img {
			height: 26px;
			width: auto;
		}
		.deck-team span span {
			color: #8fa8bf;
		}
		.deck-counter {
			color: #8fa8bf;
			font-size: 0.9rem;
			font-variant-numeric: tabular-nums;
			text-align: right;
		}

		.deck-dots {
			align-items: center;
			display: flex;
			gap: 7px;
		}
		.deck-dots a {
			background: #ffffff33;
			border-radius: 999px;
			display: block;
			height: 10px;
			width: 10px;
		}
		.deck-dots a.done {
			background: var(--c);
		}
		.deck-dots a.current {
			background: var(--c);
			box-shadow: 0 0 0 3px #ffffff40;
			width: 26px;
		}
		.deck-dots a[data-section="intro"] {
			--c: #008864;
		}
		.deck-dots a[data-section="demo"] {
			--c: #2368ae;
		}
		.deck-dots a[data-section="engineering"] {
			--c: #e0a100;
		}
		.deck-dots a[data-section="conclusion"] {
			--c: #4cc9a0;
		}
		/* gap between sections so the chapters read at a glance */
		.deck-dots a[data-section="demo"]:first-of-type,
		.deck-dots a[data-section="intro"] + a[data-section="demo"],
		.deck-dots a[data-section="demo"] + a[data-section="engineering"],
		.deck-dots a[data-section="engineering"] + a[data-section="conclusion"] {
			margin-left: 14px;
		}

		/* ---------- print → PDF for Canvas: one slide per landscape page ---------- */
		@page {
			margin: 0;
			size: landscape;
		}
		@media print {
			html {
				scroll-snap-type: none;
			}
			body {
				background: #fff;
			}
			.slide {
				break-after: page;
				page-break-after: always;
			}
		}
	</style>
}

// ---------------- INTRO — 2 min ----------------
templ Slide1() {
	@Frame(1, "intro", "title") {
		<img class="title-mark" src="/assets/images/summa-mark-primary.png" alt=""/>
		<h1>Summa</h1>
		<p class="lede">Accounting at the speed of real-time!</p>
		<p class="presenters">
			@Names()
		</p>
	}
}

templ Slide2() {
	@Frame(2, "intro", "") {
		<p class="eyebrow">The problem</p>
		<h2>The books belong to the whole team, but the software is built for one accountant</h2>
		<ul>
			<li>Accounting is way too complicated for non-accountants</li>
			<li>QuickBooks, Sage Intacct and Xero are slow and costly, and sharing the books means exporting a spreadsheet</li>
			<li>Summa: one live ledger everyone can open, edit together, and trace back change by change</li>
		</ul>
	}
}

templ Slide3() {
	@Frame(3, "intro", "") {
		<p class="eyebrow">Today</p>
		<h2>A working ledger you can edit together</h2>
		<div class="two-up">
			<ul>
				// VERIFY each bullet against main
				<li><strong>General Journal:</strong> edit an entry and every open browser updates instantly</li>
				<li><strong>Timeline:</strong> every change recorded, with who and when</li>
				<li><strong>Dashboard:</strong> balances and activity computed from the ledger</li>
			</ul>
			<figure class="shot"><img src="/assets/images/present/dashboard.png" alt="Summa dashboard"/><figcaption>The dashboard, running on seeded books</figcaption></figure>
		</div>
	}
}

// ---------------- DEMO — 5 min ----------------
templ Slide4() {
	@Frame(4, "demo", "") {
		<p class="eyebrow">Demo</p>
		<h2>A month in the life of the books</h2>
		<ol>
			// VERIFY drivers and steps
			<li><strong>Two people, one journal:</strong> David and Ryan open the General Journal; one edits, the other watches it land</li>
			<li><strong>Who changed that?</strong> Sawyer scrubs back through the history and finds the edit on the Timeline</li>
			<li><strong>The result:</strong> Graham shows the Dashboard reflecting the new numbers</li>
		</ol>
		<p class="note">Live: every edit, sync and history entry you see. Seeded: the starting chart of accounts and the month of transactions.</p>
	}
}

// The hand-off slide. → here leaves for /demo (see deckKeys); → there comes back to slide 6.
// Keep it on screen while the previous speaker wraps up so the switch looks intentional.
templ Slide5() {
	@Frame(5, "demo", "title") {
		<p class="eyebrow">Live</p>
		<h1>Let's see it</h1>
		<p class="lede">Same app, same server as these slides. Two browsers, one ledger.</p>
	}
}

// ---------------- SOFTWARE ENGINEERING — 2 min ----------------
templ Slide6() {
	@Frame(6, "engineering", "") {
		<p class="eyebrow">Engineering</p>
		<h2>One Go server owns the truth</h2>
		<div class="two-up">
			<ul>
				// VERIFY against the real request path (POST handler, NATS subject, SSE watch endpoint)
				<li><strong>Single writer:</strong> every edit is an HTTP POST to one Go server, so the ledger can never fork</li>
				<li><strong>Push, not poll:</strong> NATS fans each change out, and Datastar streams it to browsers over SSE</li>
				<li><strong>Small footprint:</strong> SQLite on disk, templ rendering HTML on the server, almost no hand-written JavaScript</li>
			</ul>
			// TODO: add architecture.png (browser → POST → Go server → SQLite / NATS → SSE → browsers)
			<figure class="shot"><img src="/assets/images/present/architecture.png" alt="Summa architecture diagram"/><figcaption>An edit's round trip</figcaption></figure>
		</div>
	}
}

templ Slide7() {
	@Frame(7, "engineering", "") {
		<p class="eyebrow">Engineering</p>
		<h2>What was hard, and what we chose</h2>
		<ul>
			// VERIFY: swap in the team's real war stories
			<li><strong>Concurrent edits:</strong> one authoritative server ordering every change beat merging edits on the client</li>
			<li><strong>Staying balanced:</strong> debits must equal credits after every edit, so validation lives on the server, not in the page</li>
			<li><strong>Lesson:</strong> hypermedia over SSE gave us real-time without a frontend framework, and four people in one repo meant agreeing on shared layout and CSS early</li>
		</ul>
	}
}

// ---------------- CONCLUSION — 1 min ----------------
templ Slide8() {
	@Frame(8, "conclusion", "") {
		<p class="eyebrow">Conclusion</p>
		<h2>Live collaboration works. Next: the rest of the books.</h2>
		<div class="two-up">
			<div>
				<h3>Accomplished</h3>
				<ul>
					<li>Real-time shared General Journal with change history</li>
					<li>Dashboard and Timeline on one Go, SQLite, NATS and Datastar stack</li>
				</ul>
			</div>
			<div>
				<h3>By end of semester</h3>
				<ul>
					for _, p := range presenters {
						<li><strong>{ p }:</strong> { semesterGoals[p] }</li>
					}
				</ul>
			</div>
		</div>
	}
}

templ Slide9() {
	@Frame(9, "conclusion", "title") {
		<h1>Thank you</h1>
		<p class="lede">Questions?</p>
	}
}

// ---------------- plumbing ----------------

// Frame wraps slide content in a full-viewport section with the footer.
// section: intro | demo | engineering | conclusion   (colours the dots)
// variant: "" | "title" (centred)
templ Frame(n int, section, variant string) {
	<section
		id={ fmt.Sprintf("s%d", n) }
		class={ "slide", templ.KV("slide-title", variant == "title") }
		data-section={ section }
	>
		<div class="slide-inner">
			{ children... }
		</div>
		@Footer(n)
	</section>
}

templ Footer(n int) {
	<footer class="deck-footer">
		<div class="deck-team">
			<img src="/assets/images/summa-mark-primary.png" alt="Summa"/>
			<span>
				@Names()
			</span>
		</div>
		<nav class="deck-dots" aria-label="Progress">
			for i := 1; i <= totalSlides; i++ {
				<a
					href={ templ.URL(fmt.Sprintf("#s%d", i)) }
					class={ templ.KV("done", i < n), templ.KV("current", i == n) }
					data-section={ sectionOf(i) }
					aria-label={ fmt.Sprintf("Slide %d", i) }
				></a>
			}
		</nav>
		<span class="deck-counter">{ fmt.Sprintf("%d / %d", n, totalSlides) }</span>
	</footer>
}

templ Names() {
	for i, p := range presenters {
		if i > 0 {
			<span aria-hidden="true">· </span>
		}
		{ p }
	}
}

// keep in sync with the Frame() calls above; drives dot colours
func sectionOf(i int) string {
	switch {
	case i <= 3:
		return "intro"
	case i <= 5:
		return "demo"
	case i <= 7:
		return "engineering"
	default:
		return "conclusion"
	}
}

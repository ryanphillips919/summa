// ---------------- plumbing ----------------

// Frame wraps slide content in a full-viewport section with the footer.
// section: intro | demo | engineering | conclusion   (colours the dots)
// variant: "" | "title" (centred)
templ Frame(n int, section, variant string) {
	<section
		id={ fmt.Sprintf("s%d", n) }
		class={ "slide", templ.KV("slide-title", variant == "title") }
		data-section={ section }
	>
		<div class="slide-inner">
			{ children... }
		</div>
		@Footer(n)
	</section>
}

templ Footer(n int) {
	<footer class="deck-footer">
		<div class="deck-team">
			<img src="/assets/images/summa-mark-primary.png" alt="Summa"/>
			<span>
				@Names()
			</span>
		</div>
		<nav class="deck-dots" aria-label="Progress">
			for i := 1; i <= totalSlides; i++ {
				<a
					href={ templ.URL(fmt.Sprintf("#s%d", i)) }
					class={ templ.KV("done", i < n), templ.KV("current", i == n) }
					data-section={ sectionOf(i) }
					aria-label={ fmt.Sprintf("Slide %d", i) }
				></a>
			}
		</nav>
		<span class="deck-counter">{ fmt.Sprintf("%d / %d", n, totalSlides) }</span>
	</footer>
}

templ Names() {
	for i, p := range presenters {
		if i > 0 {
			<span aria-hidden="true">· </span>
		}
		{ p }
	}
}

// keep in sync with the Frame() calls above; drives dot colours
func sectionOf(i int) string {
	switch {
	case i <= 3:
		return "intro"
	case i <= 5:
		return "demo"
	case i <= 7:
		return "engineering"
	default:
		return "conclusion"
	}
}

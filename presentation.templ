package main

import "fmt"

// Interactive Demo deck, served from inside the app. Each slide is one viewport tall and
// the page scroll-snaps; datastar's window keydown maps → ← Enter Home End and f (fullscreen).
// ↓ / ↑ / PgDn / PgUp / Space work natively. Ctrl+P → Save as PDF for the Canvas upload.
//
// Pressing → on slide `liveSlide` leaves the deck for /demo. From there → / Enter returns to
// the slide after it, ← / Esc returns to it (see DemoContent in demo.templ).
//
// Wire-up:  r.Get("/presentation", templ.Handler(Presentation()).ServeHTTP)
//
// To add a slide: write a templ SlideN, add it to the list in Presentation, bump totalSlides,
// and fix the ranges in sectionOf (and liveSlide if it moved).

var presenters = []string{"David Kendall", "Ryan Phillips", "Sawyer Evans", "Graham Taggart"}

const totalSlides = 9

// the slide where → opens the live app instead of advancing
const liveSlide = 5

// current slide = viewports scrolled + 1. Guarded `if` chain rather than `&&` tricks so
// the live-slide case can't also fall through to a scroll.
func deckKeys() string {
	return fmt.Sprintf(`
		const cur = Math.round(scrollY / innerHeight) + 1;
		if ((evt.key === 'ArrowRight' || evt.key === 'Enter') && cur === %d) { location.href = '/demo'; }
		else if (evt.key === 'ArrowRight' || evt.key === 'Enter') { scrollBy({top: innerHeight, behavior: 'smooth'}); }
		else if (evt.key === 'ArrowLeft') { scrollBy({top: -innerHeight, behavior: 'smooth'}); }
		else if (evt.key === 'Home') { scrollTo({top: 0, behavior: 'smooth'}); }
		else if (evt.key === 'End') { scrollTo({top: document.body.scrollHeight, behavior: 'smooth'}); }
		else if (evt.key === 'f') { document.documentElement.requestFullscreen(); }
	`, liveSlide)
}

templ Presentation() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Summa - Presentation</title>
			<link rel="icon" type="image/png" href="/assets/images/summa-mark-primary.png"/>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"></script>
			@DeckStyle()
		</head>
		<body data-on:keydown__window={ deckKeys() }>
			@Slide1()
			@Slide2()
			@Slide3()
			@Slide4()
			@Slide5()
			@Slide6()
			@Slide7()
			@Slide8()
			@Slide9()
		</body>
	</html>
}

templ DeckStyle() {
	<style>
:root { color: #132c52; background: #f7f5ef; font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; --footer-h: 58px; }
* { box-sizing: border-box; }
html { scroll-snap-type: y mandatory; scroll-behavior: smooth; }
body { margin: 0; }
h1, h2, h3, p, ul, ol { margin-top: 0; }

/* ---------- slide ---------- */
.slide { display: flex; flex-direction: column; height: 100vh; scroll-snap-align: start; scroll-snap-stop: always; }
.slide-inner { display: flex; flex: 1; flex-direction: column; margin: 0 auto; max-width: 1500px; min-height: 0; padding: clamp(28px, 4vw, 64px) clamp(32px, 6vw, 110px); width: 100%; }

/* ---------- type (projector-sized) ---------- */
.eyebrow { color: #008265; font-size: clamp(.95rem, 1.3vw, 1.2rem); font-weight: 760; letter-spacing: .075em; margin: 0 0 12px; text-transform: uppercase; }
h1 { color: #102e53; font-size: clamp(3.2rem, 7vw, 6rem); letter-spacing: -.045em; line-height: 1.02; margin-bottom: 18px; }
h2 { color: #102e53; font-size: clamp(2.1rem, 4.2vw, 3.6rem); letter-spacing: -.04em; line-height: 1.08; margin-bottom: clamp(20px, 3vh, 36px); }
h3 { color: #102e53; font-size: clamp(1.3rem, 2vw, 1.8rem); letter-spacing: -.02em; margin-bottom: 12px; }
.lede { color: #607390; font-size: clamp(1.4rem, 2.4vw, 2.1rem); margin-bottom: 0; }
.slide ul, .slide ol { color: #294362; font-size: clamp(1.3rem, 2.2vw, 2rem); line-height: 1.4; padding-left: 1.1em; }
.slide li { margin-bottom: .45em; }
.slide li strong { color: #102e53; }
.slide li::marker { color: #008864; }
.note { color: #607390; font-size: clamp(1rem, 1.5vw, 1.3rem); margin: auto 0 0; }

.slide-title .slide-inner { align-items: center; justify-content: center; text-align: center; }
.title-mark { height: clamp(72px, 10vw, 120px); margin-bottom: 24px; width: auto; }
.presenters { color: #607390; font-size: clamp(1.1rem, 1.6vw, 1.4rem); margin-top: 36px; }
.presenters span { color: #8fa8bf; }

.two-up { align-items: start; display: grid; flex: 1; gap: clamp(24px, 4vw, 64px); grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); min-height: 0; }

/* screenshots / diagrams — same card treatment as the dashboard */
.shot { background: #fff; border: 1px solid #e6e8e4; border-radius: 12px; box-shadow: 0 3px 12px #173a5810; margin: 0; overflow: hidden; }
.shot img { display: block; height: auto; width: 100%; }
.shot figcaption { color: #607390; font-size: 1rem; padding: 10px 16px; }

/* ---------- footer (rendered per slide) ---------- */
.deck-footer { align-items: center; background: linear-gradient(90deg, #0f3556, #0a2945); color: #f8fbff; display: grid; flex: 0 0 var(--footer-h); grid-template-columns: 1fr auto 1fr; padding: 0 clamp(18px, 3vw, 40px); }
.deck-team { align-items: center; color: #dce7f3; display: flex; font-size: .9rem; gap: 12px; }
.deck-team img { height: 26px; width: auto; }
.deck-team span span { color: #8fa8bf; }
.deck-counter { color: #8fa8bf; font-size: .9rem; font-variant-numeric: tabular-nums; text-align: right; }

.deck-dots { align-items: center; display: flex; gap: 7px; }
.deck-dots a { background: #ffffff33; border-radius: 999px; display: block; height: 10px; width: 10px; }
.deck-dots a.done { background: var(--c); }
.deck-dots a.current { background: var(--c); box-shadow: 0 0 0 3px #ffffff40; width: 26px; }
.deck-dots a[data-section="intro"] { --c: #008864; }
.deck-dots a[data-section="demo"] { --c: #2368ae; }
.deck-dots a[data-section="engineering"] { --c: #e0a100; }
.deck-dots a[data-section="conclusion"] { --c: #4cc9a0; }
/* gap between sections so the chapters read at a glance */
.deck-dots a[data-section="demo"]:first-of-type, .deck-dots a[data-section="intro"] + a[data-section="demo"], .deck-dots a[data-section="demo"] + a[data-section="engineering"], .deck-dots a[data-section="engineering"] + a[data-section="conclusion"] { margin-left: 14px; }

/* ---------- print → PDF for Canvas: one slide per landscape page ---------- */
@page { margin: 0; size: landscape; }
@media print {
  html { scroll-snap-type: none; }
  body { background: #fff; }
  .slide { break-after: page; page-break-after: always; }
}
	</style>
}


package main

import "summa/internal/ledger"

templ LedgerPage(organization string, document ledger.LedgerDocument) {
	@SummaShell(SummaPageMeta{
		Title: "Monthly Ledger · Summa", Description: "Monthly ledger report", ActiveNav: "demo",
		Stylesheet:   "/assets/demo.css",
		ModuleScript: "https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js",
	}, LedgerContent(organization, document))
}

templ LedgerContent(organization string, document ledger.LedgerDocument) {
	<div
		data-init="@get('/demo/watch', {filterSignals: {include: /^$/}})"
	>
		<header class="page-header"><div><p class="eyebrow">{ organization }</p><h1>Monthly ledger</h1><p class="subtitle">Revenue and expenses from posted entries. Make changes through the journal.</p></div><a href="/journal?adjust=1#new-adjustment">Record an adjustment</a></header>
		<div id="demo">
			@MonthlyLedgerTable(document)
		</div>
	</div>
}

templ MonthlyLedgerTable(document ledger.LedgerDocument) {
	<section id="ledger-report" class="table-scroll">
		<table>
			<caption>Monthly revenue and expenses</caption>
			<thead>
				<tr>
					<th scope="col">Account</th>
					for _, date := range document.Dates {
						<th>{ date.Date.Format("Jan 2006") }</th>
					}
				</tr>
			</thead>
			<tbody>
				if len(document.Rows) == 0 {
					<tr><td>No revenue or expense accounts yet.</td></tr>
				}
				for _, row := range document.Rows {
					<tr>
						<th scope="row">{ row.Account.Name }</th>
						for _, amount := range row.Data {
							<td>{ formatDollars(amount) }</td>
						}
					</tr>
				}
			</tbody>
			<tfoot>
				<tr>
					<th scope="row">Net income</th>
					for i := range document.Dates {
						<td>{ formatDollars(monthlyNet(document, i)) }</td>
					}
				</tr>
			</tfoot>
		</table>
	</section>
}

package main

// SummaPageMeta contains the page-specific details the shared shell needs.
type SummaPageMeta struct {
	Title        string
	Description  string
	ActiveNav    string
	Stylesheet   string
	ModuleScript string
}

// SummaShell owns the document, application navigation, and responsive frame.
templ SummaShell(meta SummaPageMeta, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content={ meta.Description }/>
			<title>{ meta.Title }</title>
			<link rel="icon" type="image/png" href="/assets/images/summa-mark-primary.png"/>
			<link rel="stylesheet" href="/assets/summa.css"/>
			<link rel="stylesheet" href={ templ.URL(meta.Stylesheet) }/>
			if meta.ModuleScript != "" {
				<script type="module" src={ templ.URL(meta.ModuleScript) }></script>
			}
		</head>
		<body>
			<script>
				{
					const stops = [
						"/presentation#s5",
						"/",
						"/invoices",
						"/analytics",
						"/journal",
						"/collaboration-demo",
						"/demo",
						"/timeline",
						"/presentation#s6",
					];
					const path = location.pathname.replace(/\/$/, "") || "/";
					const i = stops.indexOf(path.startsWith("/invoices/") ? "/invoices" : path);
					if (sessionStorage.getItem("tour") === "1" && i > 0) {
						addEventListener("keydown", (e) => {
							if (e.altKey || e.ctrlKey || e.metaKey || e.target.closest("input, textarea, select, button, a, [contenteditable]")) return;
							if (e.key === "ArrowRight" || e.key === "Enter") location.href = stops[i + 1];
							if (e.key === "ArrowLeft" || e.key === "Escape") location.href = stops[i - 1];
						});
					}
				}
			</script>
			<div class="summa-shell">
				<header class="mobile-header"><a class="mobile-wordmark" href="/" aria-label="Summa dashboard"><img src="/assets/images/summa-light.png" alt="Summa"/></a><button class="mobile-menu-toggle" id="mobile-menu-toggle" type="button" aria-label="Open navigation menu" aria-controls="mobile-menu" aria-expanded="false"><i data-lucide="menu"></i></button></header>
				<aside class="sidebar">
					<a class="wordmark" href="/" aria-label="Summa dashboard"><img src="/assets/images/summa-light.png" alt="Summa"/></a>
					<nav class="primary-nav" aria-label="Primary navigation">
						<p class="nav-section">Workspace</p>
						@SummaNavLink(meta.ActiveNav, "dashboard", "/", "layout-dashboard", "Dashboard")
						<p class="nav-section">Money in</p>
						@SummaNavLink(meta.ActiveNav, "invoices", "/invoices", "file-text", "Invoices")
						@SummaNavLink(meta.ActiveNav, "customers", "/customers", "users-2", "Customers")
						<p class="nav-section">Money out</p>
						@SummaNavPlaceholder("receipt", "Bills")
						@SummaNavPlaceholder("truck", "Vendors")
						<p class="nav-section">Accounting</p>
						@SummaNavLink(meta.ActiveNav, "journal", "/journal", "book-open", "General Journal")
						@SummaNavLink(meta.ActiveNav, "timeline", "/timeline", "history", "Timeline")
						@SummaNavLink(meta.ActiveNav, "collaboration", "/collaboration-demo", "users-2", "Collaboration Prototype")
						@SummaNavLink(meta.ActiveNav, "demo", "/demo", "table", "Monthly Ledger")
						@SummaNavLink(meta.ActiveNav, "analytics", "/analytics", "line-chart", "Analytics")
					</nav>
				</aside>
				<dialog class="mobile-menu" id="mobile-menu" aria-labelledby="mobile-menu-title">
					<div class="mobile-menu-top"><span id="mobile-menu-title">Navigation</span><button class="mobile-menu-close" type="button" aria-label="Close navigation menu"><i data-lucide="x"></i></button></div>
					<nav class="mobile-nav" aria-label="Mobile navigation">
						@SummaNavLink(meta.ActiveNav, "dashboard", "/", "layout-dashboard", "Dashboard")
						@SummaNavLink(meta.ActiveNav, "journal", "/journal", "book-open", "General Journal")
						@SummaNavLink(meta.ActiveNav, "timeline", "/timeline", "history", "Timeline")
						@SummaNavLink(meta.ActiveNav, "invoices", "/invoices", "file-text", "Invoices")
						@SummaNavLink(meta.ActiveNav, "customers", "/customers", "users-2", "Customers")
						@SummaNavPlaceholder("receipt", "Bills")
						@SummaNavPlaceholder("truck", "Vendors")
						@SummaNavLink(meta.ActiveNav, "collaboration", "/collaboration-demo", "users-2", "Collaboration Prototype")
						@SummaNavLink(meta.ActiveNav, "demo", "/demo", "table", "Monthly Ledger")
						@SummaNavLink(meta.ActiveNav, "analytics", "/analytics", "line-chart", "Analytics")
					</nav>
				</dialog>
				<main class="summa-main">
					@content
				</main>
			</div>
			<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
			<script src="/assets/mobile-menu.js"></script>
		</body>
	</html>
}

templ SummaNavLink(active, current, href, icon, label string) {
	<a class={ "nav-link", templ.KV("active", active == current && current != "") } href={ templ.URL(href) }><span class="nav-icon"><i data-lucide={ icon }></i></span>{ label }</a>
}

// SummaNavPlaceholder retains navigation hierarchy without advertising an
// unfinished route as a working destination.
templ SummaNavPlaceholder(icon, label string) {
	<span class="nav-link"><span class="nav-icon"><i data-lucide={ icon }></i></span>{ label }</span>
}

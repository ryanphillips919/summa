package main

import "fmt"

templ HomePage(d DashboardData) {
	@SummaShell(SummaPageMeta{Title: "Dashboard · Summa", Description: "Financial dashboard", ActiveNav: "dashboard", Stylesheet: "/assets/homepage.css"}, HomePageContent(d))
}

templ HomePageContent(d DashboardData) {
	<header class="dashboard-header">
		<div><p class="eyebrow">{ d.Organization }</p><h1>Financial dashboard</h1><p class="subtitle">Balances from posted ledger entries.</p></div>
		<div class="header-actions"><a class="new-button" href="/invoices/new">New invoice</a></div>
	</header>
	<section class="metrics" aria-label="Financial summary">
		@DashboardMetricCard("Cash position", d.Cash)
		@DashboardMetricCard("Accounts receivable", d.Receivables)
		@DashboardMetricCard("Accounts payable", d.Payables)
		@DashboardMetricCard("Revenue", d.Revenue)
		@DashboardMetricCard("Expenses", d.Expenses)
		@DashboardMetricCard("Net income", d.NetIncome)
	</section>
	<section class="content-columns">
		<div class="dashboard-column">
			<article class="panel cash-panel">
				<div class="panel-heading"><div><h2>Cash flow</h2><p>Cash received and paid from posted ledger activity.</p></div><a href="/analytics">View forecast</a></div>
				if len(d.CashFlow) == 0 {
					<p class="panel-note">Cash activity will appear here after entries are posted.</p>
				} else {
					<div class="chart-key"><span><i class="key-bar inflow"></i>Cash in</span><span><i class="key-bar outflow"></i>Cash out</span></div>
					<div class="bar-chart" role="img" aria-label="Monthly cash received and paid chart">
						<div class="bar-y"><span>{ formatDollars(d.CashFlowScale) }</span><span>{ formatDollars(d.CashFlowScale / 2) }</span><span>$0.00</span></div>
						<div class="bars">
							for _, month := range d.CashFlow {
								<div class="month">
									<div class="bar-pair">
										<i class={ "bar", "in", month.InflowHeight } title={ "Cash in: " + formatDollars(month.Inflow) }></i>
										<i class={ "bar", "out", month.OutflowHeight } title={ "Cash out: " + formatDollars(month.Outflow) }></i>
									</div>
									<span>{ month.Month }</span>
								</div>
							}
						</div>
					</div>
				}
			</article>
			<article class="panel table-panel">
				<div class="panel-heading"><div><h2>Monthly financial trends</h2><p>Revenue and expenses from the ledger.</p></div><a href="/demo">Monthly ledger</a></div>
				<div class="table-wrap">
					<table>
						<thead><tr><th>Month</th><th class="amount">Revenue</th><th class="amount">Expenses</th><th class="amount">Net</th></tr></thead>
						<tbody>
							for _, month := range d.Trends {
								<tr><td>{ month.Month }</td><td class="amount">{ formatDollars(month.Revenue) }</td><td class="amount">{ formatDollars(month.Expenses) }</td><td class="amount">{ formatDollars(month.Net) }</td></tr>
							}
						</tbody>
					</table>
				</div>
			</article>
			<article class="panel table-panel" id="receivables">
				<div class="panel-heading"><div><h2>Recent invoices</h2><p>Receivables balance: { formatDollars(d.Receivables) }</p></div><a href="/invoices">View invoices</a></div>
				<p class="panel-note">Payments are recorded in the ledger; allocation to individual invoices is not available yet.</p>
				if len(d.Invoices) == 0 {
					<p>No invoices yet.</p>
				} else {
					<div class="table-wrap">
						<table>
							<thead><tr><th>Invoice</th><th>Customer</th><th>Status</th><th class="amount">Total</th></tr></thead>
							<tbody>
								for _, invoice := range d.Invoices {
									<tr><td><a href={ templ.URL(fmt.Sprintf("/invoices/%d", invoice.Invoice.ID)) }>{ invoice.Invoice.Number }</a></td><td>{ invoice.Customer }</td><td>{ invoiceStatus(invoice.Invoice) }</td><td class="amount">{ formatDollars(invoice.Total) }</td></tr>
								}
							</tbody>
						</table>
					</div>
				}
			</article>
		</div>
		<div class="dashboard-column">
			<article class="panel close-panel">
				<div class="panel-heading"><div><h2>Next actions</h2><p>Keep the books moving with a few focused steps.</p></div></div>
				<div class="task-list">
					for _, task := range d.Tasks {
						<a class="task" href={ templ.URL(task.Href) }><span class={ "task-state", templ.KV("complete", task.Complete) }>{ task.Mark }</span><span><strong>{ task.Label }</strong><small>{ task.Detail }</small></span></a>
					}
				</div>
			</article>
			<article class="panel table-panel" id="activity">
				<div class="panel-heading"><div><h2>Recent journal activity</h2><p>Latest posted transactions.</p></div><a href="/journal">View journal</a></div>
				if len(d.Activity) == 0 {
					<p>No transactions have been posted yet.</p>
				} else {
					<div class="table-wrap">
						<table>
							<thead><tr><th>Date</th><th>Description</th><th class="amount">Amount</th></tr></thead>
							<tbody>
								for _, item := range d.Activity {
									<tr><td>{ item.Date }</td><td>{ item.Description }</td><td class="amount">{ formatDollars(item.Total) }</td></tr>
								}
							</tbody>
						</table>
					</div>
				}
			</article>
		</div>
	</section>
}

templ DashboardMetricCard(label string, cents int64) {
	<article class="metric-card"><p class="metric-label">{ label }</p><p class="metric-value">{ formatDollars(cents) }</p><p class="metric-change">Posted ledger balance</p></article>
}
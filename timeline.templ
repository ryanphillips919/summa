package main

import "fmt"

templ TimelinePage(organization string, transactions []JournalTransaction) {
	@SummaShell(SummaPageMeta{
		Title: "Ledger Timeline · Summa", Description: "Posted ledger transactions", ActiveNav: "timeline",
		Stylesheet:   "/assets/journal.css",
		ModuleScript: "https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js",
	}, TimelineContent(organization, transactions))
}

templ TimelineContent(organization string, transactions []JournalTransaction) {
	<div data-init="@get('/timeline/watch', {filterSignals: {include: /^$/}})">
		<header class="journal-header"><div><p class="eyebrow">{ organization }</p><h1>Ledger timeline</h1><p class="subtitle">Posted transactions, newest first.</p></div><a href="/journal">View journal</a></header>
		@TimelineEntries(transactions)
	</div>
}

templ TimelineEntries(transactions []JournalTransaction) {
	<section class="journal-panel" id="timeline">
		if len(transactions) == 0 {
			<p>No posted transactions yet.</p>
		} else {
			<div class="journal-table-wrap">
				<table class="journal-table">
					<thead><tr><th>Date</th><th>Transaction and accounts</th><th>Amount</th></tr></thead>
					<tbody>
						for _, transaction := range transactions {
							<tr>
								<td>{ transaction.Date }</td>
								<td>
									<a href={ templ.URL(fmt.Sprintf("/journal#transaction-%d", transaction.ID)) }>{ transaction.Description }</a>
									<br/>
									for _, entry := range transaction.Entries {
										<small>{ entry.AccountName } · { entry.Direction } { formatDollars(entry.Amount) } </small>
									}
								</td>
								<td>{ formatDollars(transaction.Total) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}
